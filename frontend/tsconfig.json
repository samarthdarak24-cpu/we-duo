{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".nextbuild/types/**/*.ts",
    ".next_verify7/types/**/*.ts",
    ".next_verify/types/**/*.ts",
    ".next_static/types/**/*.ts",
    ".next_verify9/types/**/*.ts",
    ".next_verify_final/types/**/*.ts",
    ".next_verify_final2/types/**/*.ts",
    ".next_verify10/types/**/*.ts",
    ".next_verify11/types/**/*.ts",
    ".next_verify12/types/**/*.ts",
    ".next_verify13/types/**/*.ts",
    ".next_qa_dev/types/**/*.ts",
    ".next_verify_build/types/**/*.ts",
    ".next_live/types/**/*.ts",
    ".next_browser_prod/types/**/*.ts",
    ".next_e2e/types/**/*.ts",
    ".next_qa22/types/**/*.ts",
    ".next_qa/types/**/*.ts",
    ".next_independent/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "precedent",
    "deploy",
    "test-results",
    "playwright-report",
    "vitest.config.ts",
    "tests/**/*",
    "e2e/**/*",
    "playwright.config.ts"
  ]
}
