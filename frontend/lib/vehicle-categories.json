    "battery_warranty": { "label": "Battery warranty document", "appliesTo": "electric" },
    "battery_inspection": { "label": "Battery inspection report", "appliesTo": "electric" },
    "battery_health": { "label": "Battery health / SOH report", "appliesTo": "electric" },
