{
  "version": "multicategory-1.0.0",
  "description": "Single source of truth for TrustDrive vehicle categories. Consumed by Next.js (frontend/lib/vehicle-categories.ts) and FastAPI (backend/app/categories.py). Adding a category means adding a profile here, never rewriting the verification engine.",
  "principles": [
    "One shared verification engine; category profiles only supply rules, fields and component sets.",
    "Identifier validation is category-specific. No universal 17-character VIN rule.",
    "Electric vehicles must never be asked for engine number, engine CC, fuel type or PUC.",
    "Missing evidence is unverified coverage, never proven fraud and never a clean record.",
    "A 3D asset is never substituted across categories. Unavailable assets are labelled and interactions disabled.",
    "OCR extraction is not proof that a document is genuine.",
    "AI findings cite evidence IDs, rule/model version and method."
  ],
  "jurisdictions": {
    "IN": {
      "label": "India",
      "registrationPattern": "^[A-Z]{2}[0-9]{1,2}[A-Z]{0,3}[0-9]{1,4}$",
      "registrationExample": "MH12AB1234",
      "note": "State code, district number, optional series letters and a 1-4 digit serial. Normalised to upper case with spaces and hyphens removed. Provider lookups remain an authorised-adapter concern; no Vahan/MoRTH access is assumed."
    }
  },
  "defaultJurisdiction": "IN",
  "classes": [
    { "id": "two_wheeler", "label": "Two-wheeler", "wheels": 2 },
    { "id": "three_wheeler", "label": "Three-wheeler", "wheels": 3 },
    { "id": "four_wheeler", "label": "Four-wheeler", "wheels": 4 },
    { "id": "commercial", "label": "Commercial vehicle", "wheels": null }
  ],
  "powertrains": [
    { "id": "petrol", "label": "Petrol", "hasEngine": true, "hasBatteryPack": false, "pucApplicable": true },
    { "id": "diesel", "label": "Diesel", "hasEngine": true, "hasBatteryPack": false, "pucApplicable": true },
    { "id": "cng", "label": "CNG", "hasEngine": true, "hasBatteryPack": false, "pucApplicable": true },
    { "id": "hybrid", "label": "Hybrid", "hasEngine": true, "hasBatteryPack": true, "pucApplicable": true },
    { "id": "electric", "label": "Electric", "hasEngine": false, "hasBatteryPack": true, "pucApplicable": false }
  ],
  "fieldCatalog": {
    "reg_no": { "label": "Registration number", "type": "text", "required": true, "placeholder": "MH12AB1234", "help": "As printed on the Registration Certificate.", "column": "reg_no" },
    "primary_identifier": { "label": "VIN / chassis / frame number", "type": "text", "required": true, "placeholder": "", "help": "Primary factory identifier for this vehicle class.", "column": "vin" },
    "engine_number": { "label": "Engine number", "type": "text", "required": false, "placeholder": "", "help": "Only for vehicles with a combustion engine.", "column": "specs" },
    "motor_number": { "label": "Motor number", "type": "text", "required": false, "placeholder": "", "help": "Electric traction motor identifier, where available.", "column": "specs" },
    "make": { "label": "Manufacturer", "type": "text", "required": true, "placeholder": "e.g. Honda", "help": "", "column": "make" },
    "model": { "label": "Model", "type": "text", "required": true, "placeholder": "e.g. Activa 6G", "help": "", "column": "model" },
    "variant": { "label": "Variant", "type": "text", "required": false, "placeholder": "e.g. DLX / Standard", "help": "", "column": "variant" },
    "year": { "label": "Manufacturing year", "type": "number", "required": true, "min": 1950, "max": 2030, "help": "", "column": "year" },
    "color": { "label": "Colour", "type": "text", "required": false, "placeholder": "", "help": "", "column": "color" },
    "location": { "label": "Location", "type": "text", "required": false, "placeholder": "City, State", "help": "", "column": "location" },
    "ownership_count": { "label": "Number of owners", "type": "number", "required": false, "min": 1, "max": 20, "help": "Seller-declared until ownership documents are verified.", "column": "ownership_count" },
    "asking_price": { "label": "Asking price (INR)", "type": "number", "required": false, "min": 0, "help": "", "column": "asking_price" },
    "odometer_km": { "label": "Current odometer reading (km)", "type": "number", "required": false, "min": 0, "max": 2000000, "help": "Seller-submitted reading; it is a claim until corroborated by evidence.", "column": "km_claimed" },
    "engine_cc": { "label": "Engine capacity (CC)", "type": "number", "required": false, "min": 0, "max": 20000, "help": "Combustion vehicles only.", "column": "specs" },
    "transmission": { "label": "Transmission", "type": "select", "required": false, "options": ["Manual", "Automatic", "CVT", "Direct drive"], "help": "", "column": "transmission" },
    "bike_type": { "label": "Bike / scooter type", "type": "select", "required": false, "options": ["Commuter", "Sport", "Cruiser", "Adventure", "Scooter", "Moped", "Electric scooter", "Electric motorcycle"], "help": "", "column": "specs" },
    "front_tyre": { "label": "Front tyre condition", "type": "select", "required": false, "options": ["Good", "Worn", "Needs replacement", "Not inspected"], "help": "Seller-declared condition, not an inspection result.", "column": "specs" },
    "rear_tyre": { "label": "Rear tyre condition", "type": "select", "required": false, "options": ["Good", "Worn", "Needs replacement", "Not inspected"], "help": "Seller-declared condition, not an inspection result.", "column": "specs" },
    "brake_condition": { "label": "Brake condition", "type": "select", "required": false, "options": ["Good", "Worn", "Needs replacement", "Not inspected"], "help": "Seller-declared condition, not an inspection result.", "column": "specs" },
    "motor_type": { "label": "Motor type", "type": "select", "required": false, "options": ["Hub motor", "Mid-drive", "Belt drive", "Unknown"], "help": "", "column": "specs" },
    "battery_chemistry": { "label": "Battery chemistry", "type": "select", "required": false, "options": ["Lithium-ion", "LFP", "NMC", "Lead-acid", "Unknown"], "help": "Only when stated by manufacturer or battery documentation.", "column": "specs" },
    "battery_capacity_kwh": { "label": "Battery capacity (kWh)", "type": "number", "required": false, "min": 0, "max": 500, "step": 0.1, "help": "From battery documentation, not estimated.", "column": "specs" },
    "battery_serial": { "label": "Battery serial number", "type": "text", "required": false, "placeholder": "", "help": "Where available on the battery pack or warranty card.", "column": "specs" },
    "battery_soh": { "label": "Battery State of Health (%)", "type": "number", "required": false, "min": 0, "max": 100, "help": "Only when supported by a battery health report. Never inferred from photographs or distance.", "column": "specs" },
    "charging_system": { "label": "Charging system", "type": "select", "required": false, "options": ["Standard AC", "Fast DC", "Removable battery", "Both", "Unknown"], "help": "", "column": "specs" },
    "charging_port_condition": { "label": "Charging port condition", "type": "select", "required": false, "options": ["Good", "Damaged", "Corroded", "Not inspected"], "help": "Visible external condition only.", "column": "specs" },
    "battery_warranty": { "label": "Battery warranty status", "type": "select", "required": false, "options": ["Active", "Expired", "Unknown", "Not provided"], "help": "Requires a warranty document to be verified.", "column": "specs" },
    "battery_replacement_history": { "label": "Battery replacement history", "type": "select", "required": false, "options": ["None declared", "Replaced once", "Replaced more than once", "Unknown"], "help": "Seller-declared until invoices are supplied.", "column": "specs" },
    "range_estimate_km": { "label": "Current range estimate (km)", "type": "number", "required": false, "min": 0, "max": 1000, "help": "Only when a source is supplied.", "column": "specs" },
    "range_source": { "label": "Range estimate source", "type": "select", "required": false, "options": ["Manufacturer claim", "Battery health report", "Dashboard record", "Seller estimate", "Unknown"], "help": "Required whenever a range estimate is entered.", "column": "specs" },
    "interior_condition": { "label": "Interior condition", "type": "select", "required": false, "options": ["Good", "Fair", "Worn", "Not inspected"], "help": "Seller-declared condition.", "column": "specs" },
    "exterior_condition": { "label": "Exterior condition", "type": "select", "required": false, "options": ["Good", "Fair", "Worn", "Not inspected"], "help": "Seller-declared condition.", "column": "specs" }
  },
  "documentCatalog": {
    "rc": { "label": "Registration Certificate (RC)", "appliesTo": "all" },
    "rc_2w": { "label": "Two-wheeler Registration Certificate", "appliesTo": "two_wheeler" },
    "insurance": { "label": "Insurance policy", "appliesTo": "all" },
