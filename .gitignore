# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Local tooling / agent state (never commit)
.workbuddy-ai/
.freebuff/
ezgif*.zip

# QA run artifacts (keep harness source, ignore outputs)
project/qa/**/results/
project/qa/**/reports/
project/qa/**/screenshots/
project/qa/**/*.zip
project/qa/**/trace*
project/qa/.test-out/

# Reorganization staging (duplicates, stale builds, legacy copies)
project/archive/
project/legacy/

# Tests
test-results/
playwright-report/
allure-results/

# Temporary uploads
tmp/
temp/
.tmp_*
.qa*
.shots*
.td-verify-saved

# Local data (database, uploads, backups)
.data/
data/*.db
data/*.db-wal
data/*.db-shm

# Keep source assets, migrations and lockfiles tracked
!frontend/public/
!frontend/public/**
!backend/alembic/
!backend/alembic/**
!package-lock.json
!backend/requirements*.txt
deploy/

# QA runtime artefacts: local database backups and generated result files can
# contain live session tokens or seeded user rows. Never commit them.
project/qa/**/*.db
project/qa/**/*.db-wal
project/qa/**/*.db-shm
project/qa/backups/
project/qa/*results*.json
project/qa/browser-sweep.json

# Agent / IDE tooling state (local only, never part of the project)
.agents/
.workbuddy/
*.genie
