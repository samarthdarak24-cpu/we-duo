# TrustDrive — variable names and safe placeholders only.
# Copy to `.env` for local development. Never commit a real `.env`.
# Both runtimes load this file: Next.js (node --env-file semantics via .env)
# and the FastAPI service (app/config.py `_load_dotenv`).

# ---- Application ----
NODE_ENV=development
PORT=3000
TD_ENV=local
TD_LOG_LEVEL=INFO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Shared database ----
# Local default: one SQLite file shared by Next.js (node:sqlite) and FastAPI.
TD_DATA_DIR=.data
TD_DB_FILE=.data/trustdrive.db
# FastAPI derives an absolute SQLite URL from the repo root when this is unset.
# TD_DB_URL=sqlite+pysqlite:///./.data/trustdrive.db
# Render/container (persistent disk):
# TD_DATA_DIR=/data
# TD_DB_FILE=/data/trustdrive.db
# TD_DB_URL=sqlite+pysqlite:////data/trustdrive.db
# Postgres is supported by the FastAPI service only until the Next data layer is
# migrated; do not point the two runtimes at different databases.
# TD_DB_URL=postgresql+psycopg://trustdrive:change-me@postgres:5432/trustdrive

# ---- Auth / sessions ----
# REQUIRED in production and identical for both runtimes. Generate:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value
SESSION_TTL_HOURS=24
TD_SERVICE_TOKEN=replace-with-a-shared-internal-token
# Required in production: signed downloads fail closed without one.
DOWNLOAD_SIGNING_SECRET=replace-with-a-long-random-secret
QR_SIGNING_SECRET=replace-with-a-qr-signing-secret
TD_SHARE_SECRET=replace-with-a-share-link-secret
TD_RATE_LIMIT_AUTH=10
TD_RATE_LIMIT_WINDOW=60

# ---- Seed / bootstrap ----
# 1 = local demo accounts; 0 = production (no demo accounts).
TD_SEED_DEMO=1
# Used only when TD_SEED_DEMO=0 and the users table is empty.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-8-plus-chars

# ---- File storage ----
TD_UPLOAD_DIR=.data/uploads
# TD_STORAGE_PROVIDER=local   # local (default) | s3
# TD_S3_ENDPOINT=http://127.0.0.1:9000   # moto/MinIO for local S3 testing
# TD_S3_BUCKET=trustdrive
# TD_S3_REGION=us-east-1
# TD_S3_ACCESS_KEY_ID=
# TD_S3_SECRET_ACCESS_KEY=
# TD_S3_FORCE_PATH_STYLE=1    # set 1 for moto/MinIO
# TD_QUARANTINE_DIR=.data/quarantine   # infected files go here, outside the servable root

# ---- Intelligence service ----
TD_INTELLIGENCE_URL=http://127.0.0.1:8000
TD_INTELLIGENCE_TIMEOUT_MS=90000
TD_JOB_MAX_ATTEMPTS=3
TD_JOB_TIMEOUT_SECONDS=120
TD_WORKER_POLL_SECONDS=2
# TD_BROKER_URL=redis://redis:6379/0

# ---- Durable LangGraph checkpoints ----
# sqlite = persist investigation threads to the checkpoint file (default when
# langgraph-checkpoint-sqlite is installed); memory = explicitly non-durable.
TD_CHECKPOINT_BACKEND=sqlite
TD_CHECKPOINT_DB=.data/langgraph-checkpoints.db

# ---- LLM ----
# local = on-device transformers (no key); none = deterministic answer only.
TD_LLM_PROVIDER=local
TD_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
TD_LLM_MAX_NEW_TOKENS=220
# TD_LLM_BASE_URL=https://api.openai.com/v1
# TD_LLM_API_KEY=

# ---- OCR / ML ----
TD_MODEL_DIR=services/ai/shared/models
# Real OCR engine used by the document endpoints. Default (auto) prefers
# RapidOCR/ONNX when installed (~5 s per image) and falls back to PaddleOCR only
# when RapidOCR is absent. PaddleOCR's first CPU inference measured ~96 s, which
# exceeds the Next.js proxy timeout, so forcing it makes "Extract with OCR" fail
# interactively. Set `paddleocr` only for offline accuracy experiments.
# TD_OCR_PROVIDER=auto          # auto | rapidocr | paddleocr
# TD_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TD_PGVECTOR_URL=postgresql+psycopg://trustdrive:change-me@postgres:5432/trustdrive

# ---- Provider checks (RTO / insurer) ----
# TD_PROVIDER_URL=
# TD_PROVIDER_NAME=
# TD_PROVIDER_TOKEN=

# ---- Malware scanning ----
# Local signature scan is always on; set a host for a full ClamAV daemon.
# TD_CLAMAV_HOST=127.0.0.1
# TD_CLAMAV_PORT=3310
# TD_CLAMAV_TIMEOUT_MS=15000
# TD_CLAMAV_MAX_BYTES=26214400
# or an HTTP scanning service:
# TD_MALWARE_SCAN_URL=
# TD_MALWARE_SCAN_TOKEN=
# TD_MALWARE_SCAN_TIMEOUT_MS=8000

# ---- Outbound email (SMTP) ----
# TD_SMTP_HOST=127.0.0.1
# TD_SMTP_PORT=587
# TD_SMTP_SECURE=0
# TD_SMTP_USER=
# TD_SMTP_PASSWORD=
# TD_SMTP_FROM=TrustDrive <no-reply@trustdrive.local>
# TD_SMTP_TIMEOUT_MS=15000
# TD_SMTP_MAX_ATTEMPTS=3

# ---- Outbound SMS (HTTP gateway) ----
# TD_SMS_URL=http://127.0.0.1:2526/sms
# TD_SMS_TOKEN=
# TD_SMS_FROM=TRUSTDRIVE
# TD_SMS_TIMEOUT_MS=15000
# TD_SMS_MAX_ATTEMPTS=3

# ---- Blockchain (optional, NOT claimed) ----
# The local SHA-256 chain is always available and is the only integrity proof
# the app makes. Setting these enables the OPTIONAL EVM anchor: the backend
# signs a transaction that stores the document's existing SHA-256 on-chain.
# Without a funded testnet key, a contract address and an RPC endpoint, the
# app keeps reporting the local chain and never claims an on-chain anchor.
# TD_CHAIN_RPC_URL=
# TD_CHAIN_CONTRACT=
# TD_CHAIN_PRIVATE_KEY=      # never exposed to the browser; server-side only
# TD_CHAIN_ID=
# TD_CHAIN_CONFIRMATIONS=1
# TD_CHAIN_TIMEOUT_MS=30000

# ---- External registries (VAHAN / insurer / theft) ----
# These remain BLOCKED without authorized access. Each adapter needs a base
# URL, a token and a rate limit; a lookup additionally requires a recorded
# user consent. Nothing is scraped and no user-submitted document is ever
# reported as government-verified.
# TD_VAHAN_BASE_URL=
# TD_VAHAN_TOKEN=
# TD_VAHAN_TIMEOUT_MS=10000
# TD_VAHAN_RATE_LIMIT_PER_MIN=30
# TD_INSURER_BASE_URL=
# TD_INSURER_TOKEN=
# TD_INSURER_TIMEOUT_MS=10000
# TD_INSURER_RATE_LIMIT_PER_MIN=30
# TD_THEFT_BASE_URL=
# TD_THEFT_TOKEN=
# TD_THEFT_TIMEOUT_MS=10000
# TD_THEFT_RATE_LIMIT_PER_MIN=30
# TD_REGISTRY_CONSENT_VERSION=1
# TD_REGISTRY_AUDIT_ENABLED=1

# ---- PostgreSQL (production data layer) ----
# The Next.js data layer still runs on SQLite by default. Setting
# TD_DATABASE_URL enables the PostgreSQL pool used by the migration tooling;
# cutting the app over is an explicit operator step (see
# POSTGRESQL_MIGRATION_REPORT.md).
# TD_DATABASE_URL=postgresql://trustdrive:change-me@host:5432/trustdrive
# TD_DB_POOL_MAX=10
# TD_DB_SSL=require
# TD_DB_SSL_REJECT_UNAUTHORIZED=1
# TD_DB_IDLE_TIMEOUT_MS=30000
# TD_DB_CONNECT_TIMEOUT_MS=10000
# TD_DB_STATEMENT_TIMEOUT_MS=30000

# ---- Backups ----
# TD_BACKUP_DIR=.data/backups   # snapshot target for scripts/backup-db.mjs

# ---- Production compose ----
POSTGRES_DB=trustdrive
POSTGRES_USER=trustdrive
POSTGRES_PASSWORD=change-me

# ---- Build isolation (verification builds only) ----
NEXT_DIST_DIR=.next
# NEXT_OUTPUT=standalone   # used by Dockerfile.render
