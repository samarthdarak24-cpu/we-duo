{
  "name": "trustdrive-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "TrustDrive workspace. Frontend in frontend/, FastAPI backend in backend/, AI/ML assets in services/, docs and tooling in project/.",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:all": "node project/scripts/start-local.mjs --dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm run start",
    "start:all": "node project/scripts/start-local.mjs",
    "lint": "cd frontend && npm run lint",
    "typecheck": "cd frontend && npx tsc --noEmit",
    "test": "cd frontend && npm test",
    "test:integration": "node project/qa/run-integration-tests.mjs",
    "test:backend": "cd backend && node ../project/scripts/setup/py.mjs -m pytest -q",
    "test:all": "npm run typecheck && npm test && npm run test:backend && npm run test:integration",
    "test:e2e": "cd frontend && npx playwright test",
    "qa:live": "node project/qa/live_e2e.mjs",
    "seed:reset": "cd frontend && node scripts/reset-seed.mjs",
    "schema:dump": "cd frontend && node scripts/dump-schema.mjs",
    "intel:serve": "node project/scripts/setup/py.mjs -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "intel:worker": "cd backend && node ../project/scripts/setup/py.mjs -m app.worker",
    "intel:test": "cd backend && node ../project/scripts/setup/py.mjs -m pytest -q",
    "intel:migrate": "cd backend && node ../project/scripts/setup/py.mjs -m alembic upgrade head",
    "models:build": "node project/scripts/build-vehicle-models.mjs",
    "secrets:scan": "node project/scripts/scan-secrets.mjs",
    "compose:config": "docker compose -f project/infra/docker/docker-compose.yml config",
    "render:validate": "node project/scripts/setup/py.mjs project/scripts/setup/validate_render.py"
  }
}
